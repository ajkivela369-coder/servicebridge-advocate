FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY forge_core /app/forge_core
COPY forge_base /app/forge_base
ENV FORGE_HOME=/forge
RUN mkdir -p /forge
EXPOSE 8765
CMD ["uvicorn","forge_core.main:app","--host","0.0.0.0","--port","8765"]
