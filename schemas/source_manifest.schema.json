{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servicebridge.example/schemas/source_manifest.schema.json",
  "title": "ServiceBridge source manifest",
  "type": "object",
  "required": ["title", "path", "evidence_class"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "evidence_class": {
      "enum": [
        "official_record",
        "clinical_record",
        "medical_opinion",
        "lay_statement",
        "claimant_report",
        "legal_authority",
        "research",
        "correspondence",
        "unknown"
      ]
    },
    "document_date": {"type": ["string", "null"], "format": "date"},
    "author": {"type": ["string", "null"]},
    "redact": {"type": "boolean", "default": true},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
