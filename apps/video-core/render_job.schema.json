{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Cinematic Render Job",
  "type": "object",
  "required": [
    "job_id",
    "app",
    "title",
    "stage",
    "rights_basis",
    "settings"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "planned",
        "preview",
        "generated",
        "rendered",
        "qc_passed",
        "export_ready"
      ]
    },
    "rights_basis": {
      "enum": [
        "owned",
        "licensed",
        "permission",
        "public_domain",
        "generated_original",
        "unknown"
      ]
    },
    "attribution": {
      "type": "string"
    },
    "source_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "set_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_take_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "video_bitrate_mbps",
        "audio_lufs",
        "quality"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "video_bitrate_mbps": {
          "type": "integer",
          "minimum": 1
        },
        "audio_lufs": {
          "type": "integer"
        },
        "quality": {
          "enum": [
            "highest_available",
            "balanced",
            "fast_preview"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}